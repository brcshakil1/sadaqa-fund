PORT=5000

# MongoDB Atlas connection string (free M0 cluster)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/sadaqah-fund?retryWrites=true&w=majority

# Any long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string

# Frontend URL(s) allowed to call this API, comma separated. Use * while testing.
CLIENT_URL=http://localhost:5173

# First admin account, created automatically on first start if no admin exists.
# Log in with it, then change the password from the Profile page.
SEED_ADMIN_ID=admin1
SEED_ADMIN_NAME=First Admin
SEED_ADMIN_PASSWORD=ChangeMe123
